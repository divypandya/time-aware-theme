{
  "name": "@divypandya/time-aware-theme",
  "version": "0.2.0",
  "description": "Time-aware theme resolver, DOM controller, React adapter, and test utilities.",
  "type": "module",
  "license": "MIT",
  "author": "Divy Pandya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/divypandya/time-aware-theme.git"
  },
  "homepage": "https://github.com/divypandya/time-aware-theme#readme",
  "bugs": {
    "url": "https://github.com/divypandya/time-aware-theme/issues"
  },
  "keywords": [
    "theme",
    "dark-mode",
    "color-scheme",
    "design-tokens",
    "oklch",
    "react"
  ],
  "private": false,
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.md"
  ],
  "engines": {
    "node": ">=24 <27",
    "npm": ">=11.5.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./react-ui": {
      "types": "./dist/react-ui.d.ts",
      "import": "./dist/react-ui.js"
    },
    "./inspect": {
      "types": "./dist/inspect.d.ts",
      "import": "./dist/inspect.js"
    },
    "./tailwind": {
      "types": "./dist/tailwind.d.ts",
      "import": "./dist/tailwind.js"
    },
    "./presets/dawn-to-dusk": {
      "types": "./dist/presets/dawn-to-dusk.d.ts",
      "import": "./dist/presets/dawn-to-dusk.js"
    },
    "./presets/tidal": {
      "types": "./dist/presets/tidal.d.ts",
      "import": "./dist/presets/tidal.js"
    },
    "./presets/contrast-first": {
      "types": "./dist/presets/contrast-first.d.ts",
      "import": "./dist/presets/contrast-first.js"
    },
    "./presets/paper": {
      "types": "./dist/presets/paper.d.ts",
      "import": "./dist/presets/paper.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "certify": "node scripts/certify.mjs",
    "presets": "node scripts/generate-presets.mjs",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "size": "node scripts/size-check.mjs",
    "bench": "node scripts/benchmark.mjs",
    "pack:dry": "npm pack --dry-run"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitest/coverage-v8": "^3.2.4",
    "culori": "^4.0.2",
    "eslint": "^9.34.0",
    "fast-check": "^4.9.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  }
}
