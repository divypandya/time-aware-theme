{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    // examples/react imports the package by name, the way a real installer
    // would. Without this the specifier only resolves when that example's own
    // node_modules happens to be installed, which is true locally and false in
    // CI. Mirrors the resolve alias in vitest.config.ts.
    "paths": {
      "@divypandya/time-aware-theme": ["./src/index.ts"],
      "@divypandya/time-aware-theme/*": ["./src/*"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "allowJs": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": ["src", "test", "scripts", "*.ts", "*.tsx"],
  "exclude": ["dist", "coverage", "node_modules"]
}
